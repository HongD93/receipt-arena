{
  "name": "receipt-arena",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "lint": "eslint src scripts tests vite.config.js",
    "format:check": "prettier --check src scripts tests vite.config.js",
    "contracts:build": "node scripts/forge.mjs build",
    "contracts:test": "node scripts/forge.mjs test -vv",
    "testnet:verify": "node scripts/verify-testnet.mjs",
    "verify": "npm run lint && npm test && npm run contracts:test && npm run build"
  },
  "dependencies": {
    "@gluwa/asc-contracts": "0.2.1",
    "@gluwa/usc-sdk": "0.18.0",
    "dotenv": "17.4.2",
    "ethers": "6.17.0",
    "vue": "3.5.42"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.8",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "vite": "8.2.2"
  }
}
